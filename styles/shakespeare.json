  "characteristics": [
    "Archaic pronouns (thou/thee/thy) for intimacy or address",
    "Inverted sentence structures for emphasis",
    "Frequent use of metaphor and antithesis",
    "Dramatic exclamations and rhetorical questions",
    "Period-appropriate vocabulary that remains understandable",
    "Preserve the original meaning - do not invent events or emotions"
  ],
  "examples": [
    {"input": "Are you coming?", "output": "Comest thou?"},
    {"input": "I don't know.", "output": "I know not."},
    {"input": "I am tired.", "output": "Mine eyes grow heavy with weariness."},
    {"input": "That's a bad idea.", "output": "Such a notion leads but to ruin."},
    {"input": "I finished the project.", "output": "I have brought this work unto its completion."},
    {"input": "We need to talk.", "output": "Pray, let us speak together."},
